from typing import List, Optional, Dict, Any
from pydantic import BaseModel, Field

class MessageContent(BaseModel):
    type: str = Field(default="text", description="Content type, e.g., text")
    text: str = Field(..., description="The actual text content of the message")

class Message(BaseModel):
    role: str = Field(..., description="Role of the sender, e.g., 'user' or 'assistant'")
    content: List[MessageContent] | str = Field(..., description="Message content structure")

class ClaudeRequest(BaseModel):
    model: str = Field(default="claude-sonnet-5", description="The Claude model variant to use")
    max_tokens: int = Field(default=1024, ge=1, description="Maximum tokens to generate")
    messages: List[Message] = Field(..., description="Array of input messages")
    system: Optional[str] = Field(default=None, description="System prompt to guide behavior")
    temperature: Optional[float] = Field(default=0.7, ge=0.0, le=1.0, description="Sampling temperature")

class ClaudeUsage(BaseModel):
    input_tokens: int = Field(..., description="Number of tokens used in the prompt")
    output_tokens: int = Field(..., description="Number of tokens generated in the response")

class ClaudeResponse(BaseModel):
    id: str = Field(..., description="Unique message identifier")
    type: str = Field(default="message", description="Response type")
    role: str = Field(default="assistant", description="Sender role")
    content: List[MessageContent] =Field(..., description="Generated content blocks")
    model: str = Field(..., description="Model that handled the request")
    stop_reason: Optional[str] = Field(default=None, description="Why generation stopped")
    usage: ClaudeUsage = Field(..., description="Token usage statistics")
